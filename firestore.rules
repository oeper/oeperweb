rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      // Keep in sync with OWNER_EMAILS in shared/account.js.
      return isSignedIn() && request.auth.token.email in ['sanhackerman@gmail.com', 'taejiding@gmail.com'];
    }
    function isAuthor(data) {
      return isSignedIn() && request.auth.token.email == data.authorEmail;
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function isBanned() {
      return isSignedIn() && exists(/databases/$(database)/documents/bans/$(request.auth.token.email));
    }

    // ── Credits currency ────────────────────────────────────────────────
    // A peer-to-peer transfer is a single batched write touching BOTH the
    // sender's and recipient's users/{email} doc at once (plus a
    // creditTransfers audit-log doc — see below). Per-document security
    // rules can't natively cross-check two documents against each other,
    // but getAfter()/get() can: the sender's rule uses getAfter() to
    // confirm the recipient's doc, in this SAME batch, ends up with
    // exactly the amount the sender is giving up, and the recipient's
    // rule mirrors that check back at the sender's doc. Batched writes are
    // all-or-nothing and every touched document's rule must independently
    // pass, so satisfying only one side's condition can never be enough on
    // its own to move a balance — both sides of the ledger are verified in
    // the same atomic operation. No credits field means a balance of 0.
    function creditsOf(data) {
      return ('credits' in data) ? data.credits : 0;
    }
    // Peer-to-peer transfers carry a 5% tax, burned rather than routed
    // anywhere (recipient simply gets less than the sender paid) — except
    // when the sender is an owner, who sends tax-free. The sender's own
    // rule is what actually enforces this (net <= 95% of gross for a
    // non-owner); the recipient's rule just has to receive whatever the
    // sender's doc says it sent, so it doesn't need to know about the tax
    // rate itself at all.
    function validTransferSender(email) {
      let to = request.resource.data.lastTransferTo;
      let amount = request.resource.data.lastTransferAmount;
      let net = request.resource.data.lastTransferNet;
      let toBefore = get(/databases/$(database)/documents/users/$(to)).data;
      let toAfter = getAfter(/databases/$(database)/documents/users/$(to)).data;
      return isSignedIn() && !isBanned()
        && request.auth.token.email == email
        && onlyChanged(['credits', 'lastTransferTo', 'lastTransferAmount', 'lastTransferNet', 'lastTransferAt'])
        && amount is number && amount > 0
        && net is number && net > 0 && net <= amount
        && (isOwner() ? net == amount : net * 100 <= amount * 95)
        && to is string && to != email
        && request.resource.data.credits is number
        && request.resource.data.credits == creditsOf(resource.data) - amount
        && request.resource.data.credits >= 0
        && creditsOf(toAfter) == creditsOf(toBefore) + net;
    }
    function validTransferRecipient(email) {
      let from = request.resource.data.lastReceivedFrom;
      let amount = request.resource.data.lastReceivedAmount;
      let fromBefore = get(/databases/$(database)/documents/users/$(from)).data;
      let fromAfter = getAfter(/databases/$(database)/documents/users/$(from)).data;
      return isSignedIn()
        && onlyChanged(['credits', 'lastReceivedFrom', 'lastReceivedAmount', 'lastReceivedAt'])
        && amount is number && amount > 0
        && from is string && from != email
        && request.resource.data.credits is number
        && request.resource.data.credits == creditsOf(resource.data) + amount
        && fromAfter.lastTransferTo == email
        && fromAfter.lastTransferNet == amount
        && creditsOf(fromBefore) - creditsOf(fromAfter) == fromAfter.lastTransferAmount;
    }

    // Grants read access for collectionGroup('comments') queries (profile.html's
    // comment count/karma stats). The nested rule under posts/{postId}/comments
    // only covers reads scoped to one post; a collection-group query spanning
    // every post's comments needs this recursive-wildcard match too.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 8000
        && request.resource.data.tags is list
        && (!('imageUrls' in request.resource.data) || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 8))
        && (!('poll' in request.resource.data) || (
          request.resource.data.poll.options is list
          && request.resource.data.poll.options.size() >= 2
          && request.resource.data.poll.options.size() <= 10
          && request.resource.data.poll.optionVotes is list
          && request.resource.data.poll.optionVotes.size() == request.resource.data.poll.options.size()
        ));

      // Author/owner can edit or delete their own post outright.
      // Anyone signed in (and not banned) may toggle their own up/downvote.
      // Any signed-in commenter may adjust commentCount when adding/removing a comment.
      // Any signed-in viewer may bump views by exactly 1 per request (client
      // dedupes per-browser via localStorage so opening a thread twice in the
      // same browser doesn't double count — not spoof-proof, just cosmetic).
      // Poll voting is its own branch: any signed-in non-banned user may
      // update the poll field as long as the option list itself stays
      // identical (only the per-option vote arrays move) — this is what
      // lets someone who isn't the post author cast/change a vote.
      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        // Bookmarking is per-viewer, not per-author, so it's granted the
        // same way as up/downvoting rather than folded into isAuthor().
        || (isSignedIn() && !isBanned() && onlyChanged(['savedBy']))
        || (isSignedIn() && onlyChanged(['commentCount']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1)
        || (isSignedIn() && !isBanned() && onlyChanged(['poll'])
            && resource.data.poll.options is list
            && request.resource.data.poll.options == resource.data.poll.options);

      allow delete: if isAuthor(resource.data) || isOwner();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() && !isBanned()
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        allow update: if isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']);

        allow delete: if isAuthor(resource.data) || isOwner();
      }
    }

    // Per-user profile (display name + optional photo), keyed by email.
    // Anyone can read (needed to show names/photos on posts/comments);
    // only the account itself can write its own profile.
    match /users/{email} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 200));
      // Owners setting or clearing a custom badge, or granting/revoking
      // bio-markdown rendering, on someone else's account — scoped to just
      // these two fields so it can't be used to rewrite the rest of a
      // profile the owner doesn't otherwise own. Clearing (setDoc with
      // badge: deleteField()) removes the key entirely, so the "not
      // present" branch covers that case.
      allow update: if isOwner() && onlyChanged(['badge', 'bioMarkdownAllowed'])
        && (!('badge' in request.resource.data) || (
          request.resource.data.badge.label is string
          && request.resource.data.badge.label.size() <= 24
          && request.resource.data.badge.icon is string
          && request.resource.data.badge.icon.size() <= 40
        ))
        && (!('bioMarkdownAllowed' in request.resource.data) || request.resource.data.bioMarkdownAllowed is bool);

      // Owner editing someone else's display name/bio/photo directly
      // (profile.html's "Edit this profile" kebab option) — same field
      // validation as the self-write rule above, just without requiring
      // the writer to be the account owner.
      allow update: if isOwner() && onlyChanged(['displayName', 'bio', 'photoURL'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 200));

      // Signed-in-devices log (settings.html's Security section) — a private
      // audit trail, not a public profile field, so only the account itself
      // can read or write it (unlike the rest of /users/{email}, which is
      // publicly readable).
      match /sessions/{sessionId} {
        allow read, delete: if isSignedIn() && request.auth.token.email == email;
        allow write: if isSignedIn() && request.auth.token.email == email
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 100;
      }

      // Credits: owners can grant (mint) any non-negative balance directly —
      // this is the only way to ever increase a total anyone holds without
      // it coming from someone else's balance (see the peer-to-peer transfer
      // functions above, which only ever move an existing balance, never
      // create one). onlyChanged(['credits']) alone is what distinguishes a
      // grant from a transfer, which always also touches the breadcrumb
      // fields those functions check.
      allow update: if isOwner() && onlyChanged(['credits'])
        && request.resource.data.credits is number && request.resource.data.credits >= 0;
      allow update: if validTransferSender(email);
      allow update: if validTransferRecipient(email);
    }

    // Ban list, keyed by email. Public read so the client can show "you're
    // banned" messaging; only the owner can ban/unban.
    match /bans/{email} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Credit transfer history — purely an audit log for credits.html's
    // "sent/received" list. The actual balance-security guarantees all live
    // in the users/{email} rules above (validTransferSender/Recipient);
    // this doc doesn't need to re-derive them, just record who/what/when
    // for display. Immutable once created — a transfer either happened or
    // it didn't, nothing here should ever change afterward.
    match /creditTransfers/{transferId} {
      allow read: if isSignedIn() && (
        request.auth.token.email == resource.data.fromEmail
        || request.auth.token.email == resource.data.toEmail
        || isOwner()
      );
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != request.auth.token.email
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // Real-money credit purchase history — audit log for credits.html's
    // "purchase history" list. Nothing writes here from the client yet
    // (billing isn't built), so `allow write: if false` for now; the
    // eventual payment webhook will write via the admin SDK, which
    // bypasses these rules entirely, same as every other server-issued
    // write in this app. Exists now so the read path and collection shape
    // don't need to change later.
    match /creditPurchases/{purchaseId} {
      allow read: if isSignedIn() && (request.auth.token.email == resource.data.email || isOwner());
      allow write: if false;
    }

    // epic AI's cross-conversation memory — facts the model decided were
    // worth remembering, written client-side (see ai.html) after the
    // cf-ai-worker Worker signals a remember_fact tool call over SSE; the
    // Worker itself has no Firestore write credentials, so this is the
    // only place these actually get persisted. Private to the account
    // they're about — unlike users/{email}, nobody else (not even other
    // signed-in users) has any reason to read someone else's remembered
    // facts, so this skips the public-read most other collections here
    // have.
    match /aiMemory/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }

    // @handle -> email lookup, so profile URLs never contain a real email
    // address. Create-only and only for your own account — once a handle
    // is claimed it's permanent (no update/delete), so links never break.
    match /handles/{handle} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Direct messages. conversationId is the two participant emails, sorted
    // and joined with "__" (computed client-side) — not strictly validated
    // here, just that the creator is one of the two participants, since a
    // mismatched id only produces an orphaned doc nobody else can read.
    match /conversations/{conversationId} {
      // resource == null when the doc doesn't exist yet (the very first
      // message between two people) — allowing that case through isn't a
      // leak (there's nothing to read), and without it the client's own
      // existence-check getDoc() before creating the first message fails
      // with "Missing or insufficient permissions" instead of a clean
      // exists:false, since resource.data errors out on a null resource.
      allow read: if isSignedIn() && (resource == null || request.auth.token.email in resource.data.participants);
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.token.email in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.token.email in resource.data.participants
        && onlyChanged(['lastMessage', 'lastMessageSenderEmail', 'lastMessageAt', 'updatedAt']);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.token.email == request.resource.data.senderEmail
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.size() > 0
              && request.resource.data.audioDuration is number)
            ||
            (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() > 0)
            ||
            (request.resource.data.videoUrl is string
              && request.resource.data.videoUrl.size() > 0)
            ||
            (request.resource.data.fileUrl is string
              && request.resource.data.fileUrl.size() > 0)
          );
        // Only the sender can edit (text messages only — voice/image/video/
        // file attachments stay immutable) or delete their own message.
        allow update: if isSignedIn() && request.auth.token.email == resource.data.senderEmail
          && onlyChanged(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isSignedIn() && request.auth.token.email == resource.data.senderEmail;
      }

      // Read-receipt marker, one doc per participant (doc id = their email)
      // — lets the OTHER participant see "Seen" on their last message.
      // Only the participant themself can write their own marker; either
      // participant can read both (needed to compute the other side's).
      match /reads/{email} {
        allow read: if isSignedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow write: if isSignedIn() && request.auth.token.email == email
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Group chats. Unlike conversations (fixed 2-participant id), members
    // and admins are just mutable lists that change over the group's life.
    function isGroupAdmin() { return request.auth.token.email in resource.data.admins; }
    // True when the ONLY thing that changed in members/admins is the
    // requester removing themself — i.e. leaving. Members.removeAll() on a
    // list that doesn't contain the email is a no-op, so this only passes
    // when the resulting lists are exactly "old minus me" (not "old minus
    // someone else", and not "old plus anyone").
    function isSelfLeave() {
      return request.resource.data.members == resource.data.members.removeAll([request.auth.token.email])
        && request.resource.data.admins == resource.data.admins.removeAll([request.auth.token.email]);
    }
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.token.email in resource.data.members;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.members is list && request.auth.token.email in request.resource.data.members
        && request.resource.data.admins is list && request.auth.token.email in request.resource.data.admins
        && request.resource.data.members.hasAll(request.resource.data.admins);
      allow update: if isSignedIn() && request.auth.token.email in resource.data.members
        && (
          // Admins can rename, set an icon, and change membership/admin
          // status freely (still must keep admins a subset of members).
          (isGroupAdmin() && onlyChanged(['name', 'icon', 'members', 'admins', 'updatedAt', 'lastMessage', 'lastMessageSenderEmail', 'lastMessageAt'])
            && request.resource.data.members is list
            && request.resource.data.admins is list
            && request.resource.data.members.hasAll(request.resource.data.admins)
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60)
          // Any member can leave on their own, admin or not.
          || (onlyChanged(['members', 'admins']) && isSelfLeave())
          // Any member can bump lastMessage/updatedAt when sending — same
          // as conversations' equivalent rule.
          || onlyChanged(['lastMessage', 'lastMessageSenderEmail', 'lastMessageAt', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isGroupAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn()
          && request.auth.token.email == request.resource.data.senderEmail
          && request.auth.token.email in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          && (
            (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000)
            || (request.resource.data.audioUrl is string && request.resource.data.audioUrl.size() > 0 && request.resource.data.audioDuration is number)
            || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0)
            || (request.resource.data.videoUrl is string && request.resource.data.videoUrl.size() > 0)
            || (request.resource.data.fileUrl is string && request.resource.data.fileUrl.size() > 0)
          );
        allow update: if isSignedIn() && request.auth.token.email == resource.data.senderEmail
          && onlyChanged(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000;
        allow delete: if isSignedIn() && request.auth.token.email == resource.data.senderEmail;
      }

      match /reads/{email} {
        allow read: if isSignedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow write: if isSignedIn() && request.auth.token.email == email
          && request.auth.token.email in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }

    // Long-form video posts (videos.html). Same shape/permissions as forum
    // posts — public read, author/owner manage, anyone signed in can vote
    // or bump the view count by exactly 1.
    match /videos/{videoId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.url is string;

      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        || (isSignedIn() && !isBanned() && onlyChanged(['savedBy']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1)
        || (isSignedIn() && onlyChanged(['commentCount'])
            && request.resource.data.commentCount == (('commentCount' in resource.data) ? resource.data.commentCount : 0) + 1);

      allow delete: if isAuthor(resource.data) || isOwner();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() && !isBanned()
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        allow update: if isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']);

        allow delete: if isAuthor(resource.data) || isOwner();
      }
    }

    // 24h-expiring Stories. expiresAt is set client-side at creation
    // (createdAt + 24h) and only used for client-side filtering — Firestore
    // doesn't auto-delete expired docs, so they just accumulate as junk you
    // can clean up later (or set a TTL policy on expiresAt in the console).
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video'];
      allow update: if false;
      allow delete: if isAuthor(resource.data) || isOwner();
    }

    // One active "note" per account — a small 60-char status, Instagram
    // Notes-style. Doc id is the author's email; overwritten in place each
    // time, so there's never more than one per user. expiresAt filtered
    // client-side same as Stories.
    match /notes/{email} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 60;
    }

    // User-uploaded projects (projects.html). Same shape/permissions as
    // videos: public read, author/owner manage, anyone signed in can vote
    // or bump the view count by exactly 1.
    match /projects/{projectId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000;

      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1);

      allow delete: if isAuthor(resource.data) || isOwner();
    }

    // Notifications for the bell icon in topnav.js. Written client-side by
    // whoever triggers them (upvoting, commenting, following, granting a
    // badge) — recipientEmail is who sees it, actorEmail must match the
    // writer so nobody can forge a notification "from" someone else.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
      allow create: if isSignedIn()
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.recipientEmail is string
        && request.resource.data.recipientEmail != request.auth.token.email;
      allow update: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail
        && onlyChanged(['read']);
      allow delete: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
    }

    // Follow graph. followId is "<followerEmail>__<followeeEmail>" (computed
    // client-side, order matters here unlike conversations). Mutual follow
    // (both directions exist) is what the client treats as "Friends" — no
    // separate friends collection needed for that.
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerEmail == request.auth.token.email
        && request.resource.data.followeeEmail is string
        && request.resource.data.followeeEmail != request.resource.data.followerEmail;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerEmail == request.auth.token.email;
    }

    // chess.html games — a single doc holds the whole game (board as FEN,
    // whose turn it is, move history), overwritten in place move-by-move
    // rather than one doc per move, since only the two players ever need
    // to see it and a live onSnapshot on one small doc is all the realtime
    // sync this needs. players/playerColors are fixed at creation (not in
    // onlyChanged below), so neither player can rewrite who's who mid-game;
    // move *legality* itself isn't re-validated here (same trust level as
    // this site's other user-generated content, e.g. post bodies) — a
    // malicious client could in principle submit an illegal board, but
    // chess.html's own engine is what both players' clients render from,
    // so this mirrors the rest of the site's threat model rather than
    // trying to re-implement chess rules in security-rules language.
    match /chessGames/{gameId} {
      allow read: if isSignedIn() && (resource == null || request.auth.token.email in resource.data.players);
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.players is list && request.resource.data.players.size() == 2
        && request.auth.token.email in request.resource.data.players
        && request.resource.data.status == 'pending'
        && request.resource.data.board is string
        && request.resource.data.turn in ['w', 'b'];
      allow update: if isSignedIn() && request.auth.token.email in resource.data.players
        && onlyChanged(['status', 'turn', 'board', 'moveHistory', 'winner', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.token.email in resource.data.players;
    }

    // uid -> email, so "who liked this" can resolve the Firebase Auth uids
    // stored in upvoters/downvoters back to a real profile via the normal
    // email-keyed users/{email} system. Public read like everything else
    // here (emails are already public via authorEmail on every post/video/
    // project); only the account itself can write its own mapping.
    match /uidLookup/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }

    // Site-wide config documents editable by owners only, e.g. config/aiModels
    // (the model picker list on ai.html) — publicly readable since ai.html's
    // chat works without sign-in, but only owners can change what's offered.
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // epic AI chat history, keyed by email — lets signed-in users pick up
    // the same chats on another device. ai.html still works fully signed
    // out (chats just stay local to that browser in that case), so this is
    // private to the account, never public like the collections above.
    match /aiChats/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }
  }
}
