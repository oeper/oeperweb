rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner() {
      // Keep in sync with OWNER_EMAILS in shared/account.js.
      return isSignedIn() && request.auth.token.email in ['sanhackerman@gmail.com', 'taejiding@gmail.com'];
    }
    function isAuthor(data) {
      return isSignedIn() && request.auth.token.email == data.authorEmail;
    }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function isBanned() {
      return isSignedIn() && exists(/databases/$(database)/documents/bans/$(request.auth.token.email));
    }

    // Grants read access for collectionGroup('comments') queries (profile.html's
    // comment count/karma stats). The nested rule under posts/{postId}/comments
    // only covers reads scoped to one post; a collection-group query spanning
    // every post's comments needs this recursive-wildcard match too.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 8000
        && request.resource.data.tags is list
        && (!('imageUrls' in request.resource.data) || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 8));

      // Author/owner can edit or delete their own post outright.
      // Anyone signed in (and not banned) may toggle their own up/downvote.
      // Any signed-in commenter may adjust commentCount when adding/removing a comment.
      // Any signed-in viewer may bump views by exactly 1 per request (client
      // dedupes per-browser via localStorage so opening a thread twice in the
      // same browser doesn't double count — not spoof-proof, just cosmetic).
      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        || (isSignedIn() && onlyChanged(['commentCount']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1);

      allow delete: if isAuthor(resource.data) || isOwner();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() && !isBanned()
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        allow update: if isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']);

        allow delete: if isAuthor(resource.data) || isOwner();
      }
    }

    // Per-user profile (display name + optional photo), keyed by email.
    // Anyone can read (needed to show names/photos on posts/comments);
    // only the account itself can write its own profile.
    match /users/{email} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 500))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 200));
      // Owners setting or clearing a custom badge on someone else's
      // account — scoped to just this one field so it can't be used to
      // rewrite the rest of a profile the owner doesn't otherwise own.
      // Clearing (setDoc with badge: deleteField()) removes the key
      // entirely, so the "not present" branch covers that case.
      allow update: if isOwner() && onlyChanged(['badge'])
        && (!('badge' in request.resource.data) || (
          request.resource.data.badge.label is string
          && request.resource.data.badge.label.size() > 0
          && request.resource.data.badge.label.size() <= 24
          && request.resource.data.badge.icon is string
          && request.resource.data.badge.icon.size() <= 40
        ));
    }

    // Ban list, keyed by email. Public read so the client can show "you're
    // banned" messaging; only the owner can ban/unban.
    match /bans/{email} {
      allow read: if true;
      allow write: if isOwner();
    }

    // @handle -> email lookup, so profile URLs never contain a real email
    // address. Create-only and only for your own account — once a handle
    // is claimed it's permanent (no update/delete), so links never break.
    match /handles/{handle} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    // Direct messages. conversationId is the two participant emails, sorted
    // and joined with "__" (computed client-side) — not strictly validated
    // here, just that the creator is one of the two participants, since a
    // mismatched id only produces an orphaned doc nobody else can read.
    match /conversations/{conversationId} {
      // resource == null when the doc doesn't exist yet (the very first
      // message between two people) — allowing that case through isn't a
      // leak (there's nothing to read), and without it the client's own
      // existence-check getDoc() before creating the first message fails
      // with "Missing or insufficient permissions" instead of a clean
      // exists:false, since resource.data errors out on a null resource.
      allow read: if isSignedIn() && (resource == null || request.auth.token.email in resource.data.participants);
      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.token.email in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.token.email in resource.data.participants
        && onlyChanged(['lastMessage', 'lastMessageSenderEmail', 'lastMessageAt', 'updatedAt']);

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.token.email == request.resource.data.senderEmail
          && request.auth.token.email in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            (request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.audioUrl is string
              && request.resource.data.audioUrl.size() > 0
              && request.resource.data.audioDuration is number)
            ||
            (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() > 0)
          );
        // Only the sender can edit (text messages only — voice/image
        // attachments stay immutable) or delete their own message.
        allow update: if isSignedIn() && request.auth.token.email == resource.data.senderEmail
          && onlyChanged(['text', 'edited', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if isSignedIn() && request.auth.token.email == resource.data.senderEmail;
      }
    }

    // Long-form video posts (videos.html). Same shape/permissions as forum
    // posts — public read, author/owner manage, anyone signed in can vote
    // or bump the view count by exactly 1.
    match /videos/{videoId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.url is string;

      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1)
        || (isSignedIn() && onlyChanged(['commentCount'])
            && request.resource.data.commentCount == (('commentCount' in resource.data) ? resource.data.commentCount : 0) + 1);

      allow delete: if isAuthor(resource.data) || isOwner();

      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn() && !isBanned()
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;

        allow update: if isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']);

        allow delete: if isAuthor(resource.data) || isOwner();
      }
    }

    // 24h-expiring Stories. expiresAt is set client-side at creation
    // (createdAt + 24h) and only used for client-side filtering — Firestore
    // doesn't auto-delete expired docs, so they just accumulate as junk you
    // can clean up later (or set a TTL policy on expiresAt in the console).
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['image', 'video'];
      allow update: if false;
      allow delete: if isAuthor(resource.data) || isOwner();
    }

    // One active "note" per account — a small 60-char status, Instagram
    // Notes-style. Doc id is the author's email; overwritten in place each
    // time, so there's never more than one per user. expiresAt filtered
    // client-side same as Stories.
    match /notes/{email} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 60;
    }

    // User-uploaded projects (projects.html). Same shape/permissions as
    // videos: public read, author/owner manage, anyone signed in can vote
    // or bump the view count by exactly 1.
    match /projects/{projectId} {
      allow read: if true;

      allow create: if isSignedIn() && !isBanned()
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000;

      allow update: if isAuthor(resource.data) || isOwner()
        || (isSignedIn() && !isBanned() && onlyChanged(['upvoters', 'downvoters']))
        || (isSignedIn() && onlyChanged(['views'])
            && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1);

      allow delete: if isAuthor(resource.data) || isOwner();
    }

    // Notifications for the bell icon in topnav.js. Written client-side by
    // whoever triggers them (upvoting, commenting, following, granting a
    // badge) — recipientEmail is who sees it, actorEmail must match the
    // writer so nobody can forge a notification "from" someone else.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
      allow create: if isSignedIn()
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.recipientEmail is string
        && request.resource.data.recipientEmail != request.auth.token.email;
      allow update: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail
        && onlyChanged(['read']);
      allow delete: if isSignedIn() && request.auth.token.email == resource.data.recipientEmail;
    }

    // Follow graph. followId is "<followerEmail>__<followeeEmail>" (computed
    // client-side, order matters here unlike conversations). Mutual follow
    // (both directions exist) is what the client treats as "Friends" — no
    // separate friends collection needed for that.
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerEmail == request.auth.token.email
        && request.resource.data.followeeEmail is string
        && request.resource.data.followeeEmail != request.resource.data.followerEmail;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerEmail == request.auth.token.email;
    }
  }
}
