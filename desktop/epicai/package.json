{
  "name": "epic-ai-desktop",
  "version": "1.0.1",
  "productName": "epic AI",
  "description": "epic AI for Windows and macOS",
  "author": "oeper <hello@oeper.dev>",
  "homepage": "https://oeper.dev/ai",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron tools/make-icons.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "dev.oeper.epicai.desktop",
    "productName": "epic AI",
    "artifactName": "epic-AI-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "quick-preload.js",
      "assets/**",
      "app/**"
    ],
    "protocols": [
      {
        "name": "epic AI",
        "schemes": [
          "epicai"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "epic-AI-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "epic AI uses the microphone when you speak a message.",
        "NSAudioCaptureUsageDescription": "epic AI uses the microphone when you speak a message."
      }
    },
    "afterPack": "tools/after-pack.js",
    "portable": {
      "artifactName": "epic-AI-Portable.${ext}"
    }
  }
}
