{
  "name": "epic-ai-desktop",
  "version": "1.0.0",
  "productName": "epic AI",
  "description": "epic AI for Windows and macOS",
  "author": "oeper <hello@oeper.dev>",
  "homepage": "https://oeper.dev/ai",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron tools/make-icons.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.oeper.epicai.desktop",
    "productName": "epic AI",
    "artifactName": "epic-AI-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "assets/**"],
    "protocols": [{ "name": "epic AI", "schemes": ["epicai"] }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
